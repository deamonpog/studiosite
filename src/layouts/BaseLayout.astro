---
import '@fontsource/iceberg/400.css';
import '@fontsource/exo-2/400.css';
import '@fontsource/exo-2/700.css';
import '@fontsource/new-rocker/400.css';
import '@fontsource/henny-penny/400.css';
import '@fontsource/bubblegum-sans/400.css';
import '@fontsource/fleur-de-leah/400.css';
import '@fontsource/love-light/400.css';
import '@fontsource/puppies-play/400.css';
import '@fontsource/updock/400.css';
import '@fontsource/estonia/400.css';
import '@fontsource/ruthie/400.css';
import '@fontsource/princess-sofia/400.css';
import '../styles/global.css';
import SiteNav from '../components/nav/SiteNav.astro';
import SiteFooter from '../components/nav/SiteFooter.astro';
import FallingLeaves from '../components/decor/FallingLeaves.astro';
import { siteMeta } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = siteMeta.tagline } = Astro.props;
const pageTitle = title === siteMeta.name ? title : `${title} · ${siteMeta.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <FallingLeaves />
    <SiteNav />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
