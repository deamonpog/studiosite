---
import BaseLayout from '../layouts/BaseLayout.astro';
import WavyBox from '../components/sections/WavyBox.astro';
---

<BaseLayout title="Page not found">
  <section class="wrap not-found">
    <WavyBox shape="blob-a" tone="tint" leaves>
      <h1>Lost in the jungle?</h1>
      <p>We couldn't find that page.</p>
      <a href="/">Back to Home</a>
    </WavyBox>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    place-items: center;
    min-height: 50vh;
    text-align: center;
  }

  .not-found a {
    color: var(--color-ink);
  }
</style>
