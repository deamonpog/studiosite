---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Gallery from '../components/sections/Gallery.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo/abcn-primary-logo.png';
import { siteMeta } from '../data/site';
---

<BaseLayout title={siteMeta.name}>
  <Hero heading={siteMeta.name} headingVisible={false} layout="stacked" tagline={siteMeta.tagline}>
    <Image slot="media" src={logo} alt={siteMeta.name} widths={[400, 800]} sizes="(min-width: 40rem) 32rem, 90vw" />
  </Hero>

  <section class="wrap artwork">
    <Gallery
      items={[
        { label: 'Concept art' },
        { label: 'Characters' },
        { label: 'Animations' },
      ]}
    />
  </section>
</BaseLayout>

<style>
  .artwork {
    padding-block: 3rem;
  }
</style>
