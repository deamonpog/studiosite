---
interface Props {
  heading: string;
  headingVisible?: boolean;
  tagline?: string;
  taglineMuted?: boolean;
  layout?: 'stacked' | 'split';
}

const { heading, headingVisible = true, tagline, taglineMuted = false, layout = 'split' } = Astro.props;
---

<section class:list={['hero', `layout-${layout}`]}>
  <div class="wrap hero-inner">
    <h1 class:list={{ 'visually-hidden': !headingVisible }}>{heading}</h1>
    <div class="hero-media">
      <slot name="media" />
    </div>
    {tagline && <p class:list={['tagline', { muted: taglineMuted }]}>{tagline}</p>}
  </div>
</section>

<style>
  .hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .layout-split .hero-inner {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    text-align: left;
    flex-wrap: wrap;
    gap: 2.5rem;
  }

  .layout-split h1 {
    flex: 1 1 16rem;
  }

  .hero-media {
    max-width: 28rem;
    width: 100%;
  }

  .layout-split .hero-media {
    flex: 1 1 20rem;
  }

  .hero-media :global(img) {
    width: 100%;
    height: auto;
  }

  .tagline {
    font-size: 1.2rem;
    max-width: 40ch;
    margin: 0;
  }

  .tagline.muted {
    color: var(--color-gray);
    font-style: italic;
  }
</style>
