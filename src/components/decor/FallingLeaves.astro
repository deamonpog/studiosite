---
import LeafShape from './LeafShape.astro';
import TwigShape from './TwigShape.astro';

const LEAF_COLORS = ['var(--logo-green)', 'var(--logo-orange)', 'var(--logo-turquoise)', 'var(--logo-yellow)'];
const TWIG_COLORS = ['var(--logo-brown)', 'var(--logo-green)', 'var(--logo-olive)', 'var(--logo-turquoise)'];
const TWIG_SHAPES = ['branch', 'y', 'straight'] as const;
const FALL_VARIANTS = ['fall-a', 'fall-b', 'fall-c'];

interface Piece {
  kind: 'leaf' | 'twig';
  left: number;
  size: number;
  duration: number;
  delay: number;
  variant: string;
  color: string;
  shape: (typeof TWIG_SHAPES)[number];
}

let twigIndex = 0;
const pieces: Piece[] = Array.from({ length: 16 }, (_, i) => {
  const kind = i % 3 === 0 ? 'twig' : 'leaf';
  const shape = kind === 'twig' ? TWIG_SHAPES[twigIndex++ % TWIG_SHAPES.length] : 'branch';
  return {
    kind,
    left: Math.round(Math.random() * 100),
    size: Math.round((1.1 + Math.random() * 1.3) * 10) / 10,
    duration: Math.round(14 + Math.random() * 14),
    delay: Math.round(Math.random() * -26),
    variant: FALL_VARIANTS[i % FALL_VARIANTS.length],
    color: kind === 'leaf' ? LEAF_COLORS[i % LEAF_COLORS.length] : TWIG_COLORS[i % TWIG_COLORS.length],
    shape,
  };
});
---

<div class="falling-leaves" aria-hidden="true">
  {
    pieces.map((piece) => (
      <span
        class={`piece ${piece.variant}`}
        style={{
          left: `${piece.left}%`,
          width: `${piece.size}rem`,
          height: `${piece.size}rem`,
          animationDuration: `${piece.duration}s`,
          animationDelay: `${piece.delay}s`,
        }}
      >
        {piece.kind === 'leaf' ? (
          <LeafShape color={piece.color} />
        ) : (
          <TwigShape variant={piece.shape} color={piece.color} />
        )}
      </span>
    ))
  }
</div>

<style>
  .falling-leaves {
    position: fixed;
    inset: 0;
    z-index: 8;
    overflow: hidden;
    pointer-events: none;
  }

  .piece {
    position: absolute;
    top: -10vh;
    display: block;
    opacity: 0.6;
    animation-name: fall-a;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .piece svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes fall-a {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(2.5rem, 28vh) rotate(80deg);
    }
    50% {
      transform: translate(-2rem, 55vh) rotate(160deg);
    }
    75% {
      transform: translate(2rem, 82vh) rotate(230deg);
    }
    100% {
      transform: translate(0, 115vh) rotate(320deg);
    }
  }

  @keyframes fall-b {
    0% {
      transform: translate(0, 0) rotate(10deg);
    }
    30% {
      transform: translate(-3rem, 32vh) rotate(-90deg);
    }
    60% {
      transform: translate(1.5rem, 68vh) rotate(-180deg);
    }
    100% {
      transform: translate(-1.5rem, 115vh) rotate(-260deg);
    }
  }

  @keyframes fall-c {
    0% {
      transform: translate(0, 0) rotate(-15deg);
    }
    35% {
      transform: translate(1.75rem, 30vh) rotate(120deg);
    }
    70% {
      transform: translate(-2.5rem, 70vh) rotate(210deg);
    }
    100% {
      transform: translate(1rem, 115vh) rotate(300deg);
    }
  }

  .fall-b {
    animation-name: fall-b;
  }

  .fall-c {
    animation-name: fall-c;
  }

  @media (prefers-reduced-motion: reduce) {
    .falling-leaves {
      display: none;
    }
  }
</style>
