---
import LeafShape from './LeafShape.astro';

interface Props {
  corner?: 'tl' | 'tr' | 'bl' | 'br';
  color?: string;
  stroke?: string;
  rotate?: number;
  size?: string;
}

const { corner = 'tr', color, stroke, rotate = 0, size = '3.5rem' } = Astro.props;
---

<div class={`leaf leaf-${corner}`} style={{ width: size, height: size, transform: `rotate(${rotate}deg)` }}>
  <LeafShape color={color} stroke={stroke} />
</div>

<style>
  .leaf {
    position: absolute;
    pointer-events: none;
  }

  .leaf-tl {
    top: -1rem;
    left: -1rem;
  }

  .leaf-tr {
    top: -1rem;
    right: -1rem;
  }

  .leaf-bl {
    bottom: -1rem;
    left: -1rem;
  }

  .leaf-br {
    bottom: -1rem;
    right: -1rem;
  }
</style>
