---
interface Props {
  corner?: 'tl' | 'tr' | 'bl' | 'br';
  color?: string;
  rotate?: number;
  size?: string;
}

const { corner = 'tr', color = 'var(--color-paper)', rotate = 0, size = '3.5rem' } = Astro.props;
---

<svg
  class={`leaf leaf-${corner}`}
  style={{ width: size, height: size, transform: `rotate(${rotate}deg)` }}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M8 56C6 34 20 10 54 6c4 26-10 46-32 50-6 1.2-11.5.8-14 0Z"
    fill={color}
    stroke="var(--color-ink)"
    stroke-width="2.5"
    stroke-linejoin="round"
  />
  <path
    d="M12 52C20 38 30 24 50 10"
    stroke="var(--color-ink)"
    stroke-width="2"
    stroke-linecap="round"
  />
</svg>

<style>
  .leaf {
    position: absolute;
    pointer-events: none;
  }

  .leaf-tl {
    top: -1rem;
    left: -1rem;
  }

  .leaf-tr {
    top: -1rem;
    right: -1rem;
  }

  .leaf-bl {
    bottom: -1rem;
    left: -1rem;
  }

  .leaf-br {
    bottom: -1rem;
    right: -1rem;
  }
</style>
