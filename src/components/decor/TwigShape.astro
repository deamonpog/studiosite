---
interface Props {
  variant?: 'branch' | 'y' | 'straight';
  color?: string;
  class?: string;
}

const { variant = 'branch', color = 'var(--logo-brown)', class: className } = Astro.props;

const paths: Record<string, string> = {
  branch: 'M10 58 48 12M25 40 17 31M35 28 44 21',
  y: 'M16 58 32 32M32 32 20 14M32 32 46 18',
  straight: 'M14 58 46 12',
};
---

<svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d={paths[variant]} stroke={color} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
</svg>
